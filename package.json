{
  "name": "bambu-hando",
  "version": "0.2.0",
  "description": "Cross-platform filament profile handoff between BambuStudio and SpoolEase",
  "type": "module",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/john-crouch/bambu-hando.git"
  },
  "bin": {
    "bambu-hando": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm run build && vitest run",
    "start": "node dist/bin.js",
    "tui:snap": "npm run build && node scripts/tui-snap.mjs"
  },
  "dependencies": {
    "@inkjs/ui": "2.0.0",
    "@napi-rs/keyring": "2.1.2",
    "ink": "8.0.0",
    "ink-gradient": "4.0.1",
    "ink-link": "5.0.0",
    "ink-text-input": "6.0.0",
    "pdfkit": "0.20.2",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "string-width": "8.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "24.19.1",
    "@types/pdfkit": "0.17.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@xterm/headless": "6.0.0",
    "ink-testing-library": "4.0.0",
    "jsqr": "1.4.0",
    "node-pty": "1.1.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
